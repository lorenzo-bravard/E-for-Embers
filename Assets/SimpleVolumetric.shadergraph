{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "463239ea9e5d40deb6cecaefcb363f5c",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "GetBoxVolume (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 882.0,
            "y": 5.000019073486328,
            "width": 237.9998779296875,
            "height": 350.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "03c0e6f03a9c49368f0239c994fdd18c"
        },
        {
            "m_Id": "cbe865c265cb46429084453ef973eec3"
        },
        {
            "m_Id": "ffb8be61f8cb4146a774d5f23aa9cb81"
        },
        {
            "m_Id": "fd7716bef9a746e297860ea90538ef0a"
        },
        {
            "m_Id": "2177d4de0e7244c38a9ba34e8d730ba5"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "GetBoxVolume",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// 1. Calcul de la direction de la vue (Rayon)\r\nfloat3 viewDir = normalize(WorldPos - CameraPos);\r\n\r\n// 2. Définition des bornes de la boite (AABB) locale\r\nfloat3 boxMin = ObjectPos - (ObjectScale * 0.5);\r\nfloat3 boxMax = ObjectPos + (ObjectScale * 0.5);\r\n\r\n// 3. Algorithme d'intersection Rayon vs Boite (Slab Method)\r\nfloat3 tMin = (boxMin - CameraPos) / viewDir;\r\nfloat3 tMax = (boxMax - CameraPos) / viewDir;\r\nfloat3 t1 = min(tMin, tMax);\r\nfloat3 t2 = max(tMin, tMax);\r\nfloat tNear = max(max(t1.x, t1.y), t1.z);\r\nfloat tFar = min(min(t2.x, t2.y), t2.z);\r\n\r\n// 4. Calcul de l'épaisseur traversée par le regard\r\nfloat thickness = max(0, tFar - max(0, tNear));\r\n\r\n// 5. Résultat\r\nDensity = thickness;"
}

